# Copy to .env when running locally, or set these as environment variables
# on your host (Render Dashboard -> Environment, or Vercel -> Settings ->
# Environment Variables). Never commit a real .env file.

# Owner Panel password — REQUIRED for the panel to work. The owner sets this
# to the same panel password they already use. Never share it.
PANEL_PASSWORD=

# Optional: a free Postgres connection string for durable data
# (Neon or Supabase free tier). Without it the app uses a local SQLite file,
# which is fine for testing but is wiped when a free host restarts the service.
DATABASE_URL=

# Optional
PORT=3000
